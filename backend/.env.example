DATABASE_URL=postgresql+asyncpg://fitness_app:fitness_app_password@localhost:5433/fitness_os
MIGRATOR_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/fitness_os
REDIS_URL=redis://localhost:6379/0

# Phase 23 HTTP security — optional for local (defaults: ENVIRONMENT=local, permissive CORS)
# ENVIRONMENT=production
# CORS_ORIGINS=https://admin.example.com,https://scanner.example.com
# Production Host allowlist for TrustedHostMiddleware (skip middleware if empty)
# ALLOWED_HOSTS=api.example.com,localhost

# Production notifications (use "disabled" when email delivery is intentionally off)
# NOTIFICATION_EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=service-account
# SMTP_PASS=inject-from-secret-manager
# SMTP_FROM=no-reply@example.com

# Production report artifacts — private S3 or S3-compatible object storage
# REPORT_STORAGE_PROVIDER=s3
# S3_BUCKET_NAME=fitness-private-reports
# S3_REGION_NAME=eu-central-1
# S3_ENDPOINT_URL=https://s3.example.com
# S3_SSE_ALGORITHM=aws:kms
# S3_KMS_KEY_ID=alias/fitness-reports
# AWS_ACCESS_KEY_ID=inject-from-secret-manager
# AWS_SECRET_ACCESS_KEY=inject-from-secret-manager
# REPORT_DOWNLOAD_URL_TTL_SECONDS=900

# Production /metrics endpoint bearer (32+ characters; secret-manager only)
# METRICS_BEARER_TOKEN=replace-with-a-long-random-secret
