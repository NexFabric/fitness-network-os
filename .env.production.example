# Copy to `.env` next to docker-compose.prod.yml. Every value must be real —
# validate_production() refuses empty S3/KMS/SMTP/Fernet. This file is not a
# launch approval.

ENVIRONMENT=production
# Use sslmode=require|verify-full, or set PRODUCTION_PRIVATE_NETWORK=1 for VPC-only.
DATABASE_URL=postgresql+asyncpg://app:change-me@db-host:5432/fitness_os?sslmode=require
MIGRATOR_DATABASE_URL=postgresql+asyncpg://migrator:change-me@db-host:5432/fitness_os?sslmode=require
REDIS_URL=rediss://redis-host:6379/0
PRODUCTION_PRIVATE_NETWORK=0
ENCRYPTION_KEY=replace-with-fernet-urlsafe-32-byte-key

CORS_ORIGINS=https://admin.example.com,https://scanner.example.com
ALLOWED_HOSTS=api.example.com
ADMIN_API_URL=https://api.example.com
SCANNER_API_URL=https://api.example.com

NOTIFICATION_EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=inject-from-secret-manager
SMTP_PASS=inject-from-secret-manager
SMTP_FROM=no-reply@example.com

REPORT_STORAGE_PROVIDER=s3
S3_BUCKET_NAME=fitness-private-reports
S3_REGION_NAME=eu-central-1
S3_SSE_ALGORITHM=aws:kms
S3_KMS_KEY_ID=alias/fitness-reports

QR_KMS_MODE=aws_kms
AWS_KMS_KEY_ID=alias/fitness-qr
AWS_REGION=eu-central-1

METRICS_BEARER_TOKEN=replace-with-at-least-32-random-chars
